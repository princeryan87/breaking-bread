[application]

config/name="Breaking Bread"
config/icon="assets/icon.png"
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/mode=2
window/vsync_mode=1

[rendering]

renderer/rendering_method="compatibility"
rendering/quality/shadows/shadow_atlas_size=2048

[physics]

common/physics_tick=60

[input]

move_left={
"deadzone": 0.5,
"events": [
{"type": "Key", "physical_keycode": "KeyA"},
{"type": "Key", "physical_keycode": "ArrowLeft"},
{"type": "JoyAxis", "axis": 0, "deadzone": 0.5}
],
"event_type": "Action"
}
move_right={
"deadzone": 0.5,
"events": [
{"type": "Key", "physical_keycode": "KeyD"},
{"type": "Key", "physical_keycode": "ArrowRight"},
{"type": "JoyAxis", "axis": 0, "deadzone": -0.5}
],
"event_type": "Action"
}
move_up={
"deadzone": 0.5,
"events": [
{"type": "Key", "physical_keycode": "KeyW"},
{"type": "Key", "physical_keycode": "ArrowUp"},
{"type": "JoyAxis", "axis": 1, "deadzone": -0.5}
],
"event_type": "Action"
}
move_down={
"deadzone": 0.5,
"events": [
{"type": "Key", "physical_keycode": "KeyS"},
{"type": "Key", "physical_keycode": "ArrowDown"},
{"type": "JoyAxis", "axis": 1, "deadzone": 0.5}
],
"event_type": "Action"
}
interact={
"deadzone": 0.5,
"events": [
{"type": "Key", "physical_keycode": "Space"},
{"type": "Key", "physical_keycode": "Enter"},
{"type": "JoyButton", "button": 0}
],
"event_type": "Action"
}
pause={
"deadzone": 0.5,
"events": [
{"type": "Key", "physical_keycode": "Escape"}
],
"event_type": "Action"
}

[autoload]

GameManager="res://autoload/game_manager.gd"