[application]

config/name="Breaking Bread"
config/icon="res://assets/icon.png"
config/features=PackedStringArray("mobile", "web")
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"

[rendering]

renderer/rendering_method="compatibility"
renderer/max_time_step=0.05

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey, "physical_keycode": 26), Object(InputEventKey, "physical_keycode": 82)]
}
move_backward={
"deadzone": 0.5,
"events": [Object(InputEventKey, "physical_keycode": 22), Object(InputEventKey, "physical_keycode": 81)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey, "physical_keycode": 4), Object(InputEventKey, "physical_keycode": 80)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey, "physical_keycode": 7), Object(InputEventKey, "physical_keycode": 79)]
}
brake={
"deadzone": 0.5,
"events": [Object(InputEventKey, "physical_keycode": 44)]
}
interact_kitchen={
"deadzone": 0.5,
"events": [Object(InputEventKey, "physical_keycode": 8)]
}
interact_sell={
"deadzone": 0.5,
"events": [Object(InputEventKey, "physical_keycode": 44)]
}
pause_menu={
"deadzone": 0.5,
"events": [Object(InputEventKey, "physical_keycode": 41)]
}

[autoload]

GameManager="*res://autoload/game_manager.gd"
UIManager="*res://autoload/ui_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"

[physics]

common/physics_ticks_per_second=60